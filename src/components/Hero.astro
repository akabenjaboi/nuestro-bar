---
import { Image } from 'astro:assets';
import compartir2Img from '../images/compartir2.jpg';
import sourRosaImg   from '../images/SourRosa.jpg';
import { WA_LINK } from '../config/site';
---

<section id="inicio" class="relative min-h-screen flex flex-col md:flex-row md:items-center pt-10 overflow-hidden">

  <!-- MOBILE background: compartir2 full-bleed -->
  <div class="md:hidden absolute inset-0">
    <Image src={compartir2Img} alt="" width={600} height={900}
      class="w-full h-full object-cover object-center" />
    <div class="absolute inset-0 bg-gradient-to-b from-brand-bg/70 via-brand-bg/10 to-brand-bg/80"></div>
  </div>

  <!-- DESKTOP background decorations -->
  <div class="hidden md:block absolute inset-0 bg-gradient-to-br from-brand-bg via-[#2e1258] to-brand-bg"></div>
  <div class="hidden md:block absolute top-20 right-0 w-[500px] h-[500px] bg-brand-rose/10 rounded-full blur-[100px] pointer-events-none"></div>
  <div class="hidden md:block absolute bottom-10 left-0 w-[400px] h-[400px] bg-brand-gold/10 rounded-full blur-[80px] pointer-events-none"></div>
  <div class="hidden md:block absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-brand-purple/10 rounded-full blur-[120px] pointer-events-none"></div>

  <!-- MOBILE LAYOUT: título arriba, párrafo+CTAs abajo, imagen visible en el medio -->
  <div class="md:hidden relative flex flex-col justify-between flex-1 px-6 pt-8 pb-14 text-center">

    <!-- Grupo superior: badge + título -->
    <div class="flex flex-col items-center">
      <span class="inline-flex items-center gap-2 text-brand-rose font-body text-xs tracking-[0.3em] uppercase mb-5 bg-brand-rose/10 border border-brand-rose/20 px-4 py-2 rounded-full">
        <span class="material-icons-round" style="font-size:14px">location_on</span>
        Desde Valdivia, Chile
      </span>
      <h1 class="font-display text-5xl text-brand-text font-bold leading-[1.1]">
        Cada copa,<br>
        <span class="text-brand-gold italic">un momento</span><br>
        para compartir
      </h1>
    </div>

    <!-- Grupo inferior: párrafo + CTAs -->
    <div class="flex flex-col items-center gap-3">
      <p class="font-body text-brand-text/85 text-base leading-relaxed mb-1 max-w-xs">
        Pisco Sour Valdiviano artesanal, listo para hacer de cada encuentro algo especial.
      </p>
      <a href={WA_LINK} target="_blank" rel="noopener noreferrer"
        class="flex items-center justify-center gap-3 w-full max-w-xs bg-[#25d366] text-white font-body font-bold text-base px-6 py-4 rounded-2xl"
        style="box-shadow: 0 6px 30px rgba(37,211,102,0.35);">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" class="w-5 h-5 fill-white flex-shrink-0">
          <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
        </svg>
        Pedir por WhatsApp
      </a>
      <a href="#producto"
        class="flex items-center justify-center gap-2 w-full max-w-xs border border-brand-text/30 text-brand-text/80 font-body text-sm px-6 py-3.5 rounded-2xl">
        <span class="material-icons-round" style="font-size:16px">explore</span>
        Descubre Más
      </a>
    </div>

  </div>

  <!-- DESKTOP LAYOUT: grid de dos columnas -->
  <div class="relative hidden md:grid max-w-6xl mx-auto px-6 py-16 grid-cols-2 gap-12 items-center w-full">

    <div class="hero-text flex flex-col items-start text-left">

      <span class="inline-flex items-center gap-2 text-brand-rose font-body text-xs tracking-[0.3em] uppercase mb-6 bg-brand-rose/10 border border-brand-rose/20 px-4 py-2 rounded-full">
        <span class="material-icons-round" style="font-size:14px">location_on</span>
        Desde Valdivia, Chile
      </span>

      <h1 class="font-display text-6xl lg:text-7xl text-brand-text font-bold leading-[1.1] mb-5">
        Cada copa,<br>
        <span class="text-brand-gold italic">un momento</span><br>
        para compartir
      </h1>

      <p class="font-body text-brand-text/65 text-lg leading-relaxed mb-8 max-w-md">
        Pisco Sour Valdiviano artesanal, listo para hacer de cada encuentro algo especial.
      </p>

      <div class="flex flex-wrap gap-4">
        <a href="#producto"
          class="inline-flex items-center gap-2 bg-brand-gold text-brand-bg font-body font-bold px-8 py-3.5 rounded-full hover:bg-brand-text transition-all duration-300 hover:scale-105 shadow-lg shadow-brand-gold/20">
          <span class="material-icons-round" style="font-size:18px">explore</span>
          Descubre Más
        </a>
        <a href={WA_LINK} target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border border-brand-text/25 text-brand-text/80 font-body px-8 py-3.5 rounded-full hover:border-brand-rose hover:text-brand-rose transition-all duration-300">
          <span class="material-icons-round" style="font-size:18px">shopping_bag</span>
          Hacer Pedido
        </a>
      </div>

      <div class="flex gap-8 mt-14 pt-8 border-t border-brand-purple/30">
        <div>
          <p class="font-display text-2xl font-bold text-brand-gold">100%</p>
          <p class="font-body text-brand-text/50 text-xs tracking-widest mt-1">ARTESANAL</p>
        </div>
        <div class="w-px bg-brand-purple/40"></div>
        <div>
          <p class="font-display text-2xl font-bold text-brand-gold">Sur</p>
          <p class="font-body text-brand-text/50 text-xs tracking-widest mt-1">DE CHILE</p>
        </div>
        <div class="w-px bg-brand-purple/40"></div>
        <div>
          <p class="font-display text-2xl font-bold text-brand-gold">∞</p>
          <p class="font-body text-brand-text/50 text-xs tracking-widest mt-1">MOMENTOS</p>
        </div>
      </div>

    </div>

    <div class="hero-image flex justify-center">
      <div class="relative">
        <div class="absolute inset-0 bg-brand-rose/25 rounded-3xl blur-3xl scale-110 pointer-events-none"></div>
        <Image src={sourRosaImg} alt="Pisco Sour Rosa — Nuestro Bar" width={440} height={520}
          class="relative rounded-3xl object-cover shadow-2xl border border-brand-purple/30 w-full max-w-[440px]" />
        <div class="absolute -bottom-5 -left-5 bg-brand-card border border-brand-gold/30 rounded-2xl px-5 py-4 backdrop-blur-sm shadow-xl">
          <div class="flex items-center gap-3">
            <span class="material-icons-round text-brand-gold" style="font-size:28px">star</span>
            <div>
              <p class="font-display text-brand-gold font-bold text-sm">Artesanal</p>
              <p class="font-body text-brand-text/50 text-xs">100% Valdiviana</p>
            </div>
          </div>
        </div>
        <div class="absolute -top-4 -right-4 bg-brand-card border border-brand-rose/30 rounded-2xl px-4 py-3 backdrop-blur-sm shadow-xl">
          <div class="flex items-center gap-2">
            <span class="material-icons-round text-brand-rose" style="font-size:22px">favorite</span>
            <p class="font-display text-brand-text font-semibold text-sm">Comparte</p>
          </div>
        </div>
      </div>
    </div>

  </div>

</section>

<style>
  .hero-text { animation: fadeInLeft 0.9s ease forwards; }
  .hero-image { animation: fadeInRight 0.9s ease 0.2s both; }

  @keyframes fadeInLeft {
    from { opacity: 0; transform: translateX(-28px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  @keyframes fadeInRight {
    from { opacity: 0; transform: translateX(28px); }
    to   { opacity: 1; transform: translateX(0); }
  }
</style>
