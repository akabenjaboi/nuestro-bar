---
import { Image } from 'astro:assets';
import logoImg from '../images/logo.jpg';
import { WA_LINK, IG_LINK } from '../config/site';
---

<footer class="pt-10 pb-6 border-t border-brand-purple/20">
  <div class="max-w-6xl mx-auto px-6">

    <div class="flex flex-col md:flex-row items-center justify-between gap-6 mb-6">
      <a href="#inicio" class="flex items-center gap-3">
        <Image src={logoImg} alt="Nuestro Bar" width={38} height={38}
          class="rounded-full object-cover ring-1 ring-brand-gold/30" />
        <div>
          <p class="font-display text-brand-text font-semibold">Nuestro Bar</p>
          <p class="font-body text-brand-text/35 text-xs tracking-widest">PISCO SOUR VALDIVIANA</p>
        </div>
      </a>

      <p class="font-body text-brand-text/35 text-sm text-center">
        Hecho con amor desde Valdivia, Chile
      </p>

      <div class="flex gap-3">
        <a href={IG_LINK} target="_blank" rel="noopener noreferrer" aria-label="Instagram"
          class="w-10 h-10 bg-brand-card/50 border border-brand-purple/20 rounded-xl flex items-center justify-center text-brand-text/50 hover:text-brand-rose hover:border-brand-rose/40 transition-all duration-200">
          <span class="material-icons-round" style="font-size:18px">photo_camera</span>
        </a>
        <a href={WA_LINK} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp"
          class="w-10 h-10 bg-brand-card/50 border border-brand-purple/20 rounded-xl flex items-center justify-center text-brand-text/50 hover:text-brand-gold hover:border-brand-gold/40 transition-all duration-200">
          <span class="material-icons-round" style="font-size:18px">chat_bubble</span>
        </a>
      </div>
    </div>

    <div class="pt-5 border-t border-brand-purple/10 flex flex-col md:flex-row items-center justify-between gap-2">
      <p class="font-body text-brand-text/25 text-xs">© 2026 Nuestro Bar — Todos los derechos reservados</p>
      <p class="font-body text-brand-text/25 text-xs">Beber con moderación · Prohibido vender alcohol a menores de 18 años</p>
    </div>

  </div>
</footer>
